PORT=3000
NODE_ENV=production

# DATABASE_URL di-override oleh docker-compose dari .env.prod
# DATABASE_URL=mysql://user:pass@mysql_prod:3306/portfolio_db

REDIS_PORT=6379
REDIS_DB=0

# Hasilkan PASETO keys baru dengan:
#   bun -e "const { generateKeyPair } = await import('paseto'); const kp = await generateKeyPair('Ed25519'); console.log('SECRET:', kp.privateKey); console.log('PUBLIC:', kp.publicKey);"
PASETO_SECRET_KEY=GANTI_DENGAN_SECRET_KEY_BARU
PASETO_PUBLIC_KEY=GANTI_DENGAN_PUBLIC_KEY_BARU

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Contact Form (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=GANTI_DENGAN_EMAIL_ANDA
SMTP_PASS=GANTI_DENGAN_APP_PASSWORD_ANDA
SMTP_FROM=noreply@rifki-saifullah.codes
ADMIN_EMAIL=admin@rifki-saifullah.codes

# Cloudflare Turnstile (server-side secret)
TURNSTILE_SECRET_KEY=GANTI_DENGAN_TURNSTILE_SECRET_KEY

# Seed user (untuk bun prisma/seed.ts di prod)
ADMIN_NAME=Rifki Saifullah
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT

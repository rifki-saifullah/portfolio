# ============================================================
# Portfolio Production Environment Variables
# Salin file ini menjadi .env.production untuk deployment
# ============================================================

DOMAIN=example.com

PUBLIC_API_URL=https://api.example.com/api
PUBLIC_MOCK_API=false
PUBLIC_TURNSTILE_SITE_KEY=GANTI_DENGAN_SITE_KEY_ANDA

PORT=3000
NODE_ENV=production
DATABASE_URL="mysql://portfolio_user:GANTI_DENGAN_PASSWORD_KUAT@mysql_prod:3306/portfolio_db"

REDIS_HOST="redis_prod"
REDIS_PORT=6379
REDIS_PASSWORD="GANTI_DENGAN_PASSWORD_KUAT"
REDIS_DB=0

PASETO_SECRET_KEY="GANTI_DENGAN_SECRET_KEY_BARU"
PASETO_PUBLIC_KEY="GANTI_DENGAN_PUBLIC_KEY_BARU"

ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGIN="https://example.com"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="GANTI_DENGAN_EMAIL_ANDA"
SMTP_PASS="GANTI_DENGAN_APP_PASSWORD_ANDA"
SMTP_FROM="noreply@example.com"
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Rifki Saifullah"
ADMIN_PASSWORD="GANTI_DENGAN_PASSWORD_ADMIN_KUAT"

TURNSTILE_SECRET_KEY="GANTI_DENGAN_TURNSTILE_SECRET_KEY"

MYSQL_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
# ============================================================
# Portfolio Production Environment Variables
# Salin file ini menjadi .env.prod dan isi dengan nilai asli
# Jangan commit file .env.prod ke repository!
# ============================================================

# Domain utama (tanpa https://)
DOMAIN=rifki-saifullah.codes

# Email untuk ACME/Let's Encrypt SSL
ACME_EMAIL=admin@rifki-saifullah.codes

# Database
MYSQL_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# Redis
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile)
TURNSTILE_SITE_KEY=GANTI_DENGAN_SITE_KEY_ANDA
